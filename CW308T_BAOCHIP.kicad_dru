(version 1)
(rule "dp clearance"
    (constraint clearance (min "1.5mm"))
    (condition "A.inDiffPair('*') && !AB.isCoupledDiffPair() && B.NetName == 'GND' && B.Type == 'Zone'"))
(rule "dp clearance 2"
    (constraint clearance (min "1.5mm"))
    (condition "A.inDiffPair('*') && !AB.isCoupledDiffPair() && B.NetName == '+3V3A' && B.Type == 'Zone'"))
